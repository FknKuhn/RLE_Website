# Copy to .env.production on the server and fill in real values.
# Never commit the real file.

# Public address of the site (used in sitemap.xml and emails)
NEXT_PUBLIC_SITE_URL=https://www.rleenterprises.com
# Your domain(s) without https:// (used by Caddy to get HTTPS certificates).
# List both forms, comma-separated, so either address works.
SITE_DOMAIN=www.rleenterprises.com, rleenterprises.com

# Cloudinary (gallery)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail (contact form) - use a Google "App Password", not your real password
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_TO_EMAIL=

# Header holding the real visitor IP, set by the reverse proxy (Caddy).
# Leave as-is when using the included docker-compose.yml.
CLIENT_IP_HEADER=x-real-ip
